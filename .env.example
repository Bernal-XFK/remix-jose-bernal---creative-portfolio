# GITHUB_TOKEN: Personal Access Token para subir el rate limit de la API de GitHub
# (/api/projects y server.ts lo usan como `Authorization: token <GITHUB_TOKEN>`).
# Opcional en local, recomendado en Vercel para evitar 403 por rate limit.
# Crea uno en https://github.com/settings/tokens (scope public_repo / read:user basta).
GITHUB_TOKEN=""

# VITE_APP_URL: URL pública canónica del sitio (para activar cuando compres el .com).
# Ej: VITE_APP_URL="https://josebernal.com"
# En Vercel: Settings > Environment Variables > añadir VITE_APP_URL (Production).
# En local: copiar a .env.local. Sin esto, canonical/og:url usan fallback relativo.
VITE_APP_URL="https://TU-DOMINIO.com"

# PORT: puerto local del servidor Express + Vite (server.ts).
PORT=3000

# CONTACT_TO: email destino del formulario (POST /api/contact).
# Requerido para envío SMTP; sin SMTP igual se usa para el fallback mailto:.
CONTACT_TO="jabernal.4395@unicesmag.edu.co"

# SMTP_* (opcionales): si están completos, /api/contact envía con nodemailer.
# Si faltan, el backend guarda en console (delivered=log) y el frontend ofrece mailto:.
# NUNCA hardcodees credenciales: solo por variables de entorno / Vercel Env Vars.
# Diagnóstico: GET /api/contact/status → { smtpReady, mode: "smtp"|"log", ... }
# (solo booleanos, sin exponer secretos). Si mode=log, NO llega email.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tu-email@gmail.com"
# SMTP_PASS="tu-app-password"
# SMTP_FROM="tu-email@gmail.com"
#
# Cómo recibir en jabernal.4395@unicesmag.edu.co con Gmail (recomendado):
# 1. Usa una cuenta Gmail emisora (p. ej. tu-email@gmail.com) con verificación
#    en 2 pasos activada: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Crea una App Password: https://myaccount.google.com/apppasswords
#    (app: Correo, dispositivo: Otro) → copia el código de 16 letras.
# 3. En local: copia este archivo a .env y rellena:
#    CONTACT_TO="jabernal.4395@unicesmag.edu.co"
#    SMTP_HOST="smtp.gmail.com"
#    SMTP_PORT="587"
#    SMTP_USER="tu-email@gmail.com"
#    SMTP_PASS="xxxx-xxxx-xxxx-xxxx"  (sin espacios al pegarla)
#    SMTP_FROM="tu-email@gmail.com"
#    Luego reinicia: npm run dev
# 4. En Vercel: Project Settings → Environment Variables → añade las 6 vars
#    anteriores (todos los Environments) → Redeploy.
# 5. Prueba: curl http://localhost:3000/api/contact/status → debe dar
#    {"smtpReady":true,"mode":"smtp",...}. Luego envía el formulario y revisa
#    la bandeja de jabernal.4395@unicesmag.edu.co (y spam).
# Nota: CONTACT_TO puede ser cualquier inbox; SMTP_USER debe ser el Gmail que
# envía. Gmail no deja enviar "desde" un @unicesmag.edu.co salvo que lo
# configures como alias en Gmail → mejor From = Gmail y To = unicesmag.
